{
  "name": "handwriting-converter",
  "version": "1.0.0",
  "description": "Convert Markdown files into realistic handwritten notes and export as PDF",
  "main": "dist/electron/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "predev": "npm run build:main",
    "prestart": "npm run build",
    "start": "cross-env-shell \"unset ELECTRON_RUN_AS_NODE && electron .\"",
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 cross-env-shell \"unset ELECTRON_RUN_AS_NODE && electron .\"",
    "dev": "concurrently -k -p \"[{name}]\" -n \"VITE,ELECTRON\" -c \"cyan.bold,magenta.bold\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "preview": "vite preview"
  },
  "keywords": [
    "handwriting",
    "markdown",
    "pdf",
    "notes",
    "electron",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.13",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
